{
  "info": {
    "_postman_id": "6e806f32-d1da-475d-b82c-2e68666b3dc1",
    "name": "IDM-Reto-Jvasquez",
    "description": "Colección de Postman para probar los endpoints reactivos del microservicio para el reto técnico de IDM.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "5717171"
  },
  "item": [
    {
      "name": "1. Crear Producto (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Retorna el ID generado', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.be.a('number');",
              "    pm.collectionVariables.set('created_product_id', jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Teclado Mecánico RGB\",\n  \"description\": \"Switch Red, inalámbrico USB-C\",\n  \"price\": 89.99,\n  \"stock\": 20,\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/products",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Listar Todos los Productos (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Respuesta es un Array/Stream', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/products",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Buscar Producto por ID (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('El producto corresponde al ID solicitado', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.eql(parseInt(pm.collectionVariables.get('created_product_id') || 1));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/products/{{created_product_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            "{{created_product_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Actualizar Producto (PUT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('El nombre y precio se actualizaron correctamente', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.eql('Teclado Mecánico RGB Pro');",
              "    pm.expect(jsonData.price).to.eql(109.99);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Teclado Mecánico RGB Pro\",\n  \"description\": \"Switch Red Inalámbrico de Alta Gama\",\n  \"price\": 109.99,\n  \"stock\": 15,\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/products/{{created_product_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            "{{created_product_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. Eliminar Producto (DELETE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 204 No Content', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/{{created_product_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            "{{created_product_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "6. Probar Error 404 (GET Not Found)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404 Not Found', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test('Estructura de error personalizada correcta', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(404);",
              "    pm.expect(jsonData.error).to.eql('Not Found');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/9999",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            "9999"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "created_product_id",
      "value": "1"
    }
  ]
